# Copy to .env and adjust. Defaults target local development only.

# SQLAlchemy database URL. Docker Compose provides PostgreSQL; for quick local
# runs you may use sqlite:///./cerberus.db
CERBERUS_DATABASE_URL=postgresql+psycopg://cerberus:cerberus@localhost:5432/cerberus

# Required. Secret used to sign JWT access tokens: at least 32 random characters. The app will
# not start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CERBERUS_JWT_SECRET=

# Bootstrap administrator, created on the first start only. The password must be at least 12
# characters and must not contain "change-me". Existing accounts are never changed.
CERBERUS_ADMIN_USERNAME=admin
CERBERUS_ADMIN_PASSWORD=

# Required. Fernet key that encrypts uploaded samples at rest. Keep it safe: losing it makes
# stored samples unreadable. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CERBERUS_STORAGE_KEY=

# Maximum uploaded sample size in bytes (default 100 MB).
CERBERUS_MAX_UPLOAD_BYTES=104857600

# development or production
CERBERUS_ENVIRONMENT=development
